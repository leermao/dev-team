{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/plugins/team-agents/bin/lint-on-write.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/plugins/team-agents/bin/track-team-ready.sh"
          }
        ]
      }
    ]
  }
}
